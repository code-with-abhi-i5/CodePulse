  createdAt                DateTime @default(now())

  @@index([challengeId, createdAt])
  @@map("challenge_synthesized_test_suites")
}

model ChallengeBenchmark {
  id                  String   @id @default(uuid())
  challengeId         String
  optimalComplexity   String   // e.g. "O(N log N)", "O(N)", "O(V + E)"
  timeLimitMs         Int      @default(1000)
  memoryLimitMb       Int      @default(128)
  syntheticCasesCount Int      @default(0)
  testDataPayload     Json     // extreme adversarial inputs
  rejectionCriteria   Json     // bounds and thresholds
  verified            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([challengeId, createdAt])
  @@map("challenge_benchmarks")
}

model GitConflictResolution {
  id               String   @id @default(uuid())
  filePath         String
  confidenceScore  Float
  resolvedByAi     Boolean
  fellBackToManual Boolean   @default(false)
  resolvedContent  String   @db.Text
  createdAt        DateTime @default(now())

  @@index([filePath, createdAt])
  @@map("git_conflict_resolutions")
}

model IssueRepro {
  id                String   @id @default(uuid())
  issueNumber       Int
  repository        String
  issueTitle        String?
  targetLanguage    String   // 'nodejs', 'python', 'bash', 'curl'
  scriptContent     String   @db.Text
  dockerfileContent String?  @db.Text
  stepsExtracted    Int      @default(0)
  syntaxValid       Boolean  @default(true)
  syntaxErrors      String?  @db.Text
  executionSuccess  Boolean? // null = unexecuted, true = reproduced, false = failed
  executionOutput   String?  @db.Text
  errorLogs         String?  @db.Text
  confidenceScore   Float    @default(0.85)
  commentPosted     Boolean  @default(false)
  commentUrl        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([repository, issueNumber])
  @@index([createdAt])
  @@map("issue_repros")
}

model SecurityPatch {
  id                    String   @id @default(uuid())
  cveId                 String
  packageName           String
  currentVersion        String
  patchedVersion        String
  cvssScore             Float
  severity              String   @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  advisorySource        String   @default("OSV") // OSV, GITHUB, NVD
  advisoryUrl           String?
  vulnerabilitySummary  String?  @db.Text
  breakingChanges       String?  @db.Text
  shimCode              String?  @db.Text
  diffSummary           String   @db.Text
  testPassRate          Float    @default(1.0)
  verifiedInSandbox     Boolean  @default(true)
  pullRequestNumber     Int?
  pullRequestTitle      String?
  pullRequestUrl        String?
  status                String   @default("SYNTHESIZED") // DETECTED, SYNTHESIZED, VERIFIED, PR_CREATED, MERGED
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([packageName, cveId])
  @@index([status])
  @@map("security_patches")
}
model TechnicalDebtForecast {
  id                              String      @id @default(uuid())
  repositoryId                    String
  currentTdr                      Float       // Technical Debt Ratio (0.0 to 1.0 or %)
  projectedTdr6Months             Float
  currentMaintainability          Float       // Maintainability Index (0-100)
  projectedMaintainability6Months  Float
  totalDebtHours                  Float       // Estimated hours needed to remediate debt
  hoursSavedByRefactoring         Float       // Estimated engineering hours saved over 12 months
  sqaleRating                     String      // 'A' (<=5%), 'B' (6-10%), 'C' (11-20%), 'D' (21-50%), 'E' (>50%)
  timeBombsCount                  Int         @default(0)
  timeBombs                       Json        // Modules where complexity is growing 3x faster than test coverage
  forecastTimeline                Json        // 6-month projected data points
  maintenanceRoadmap              Json        // Priority-ordered refactoring hotspots with ROI
  createdAt                       DateTime    @default(now())
  updatedAt                       DateTime    @updatedAt

  repository                      Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([createdAt])
  @@map("technical_debt_forecasts")
}

model MaintainabilitySnapshot {
  id                   String      @id @default(uuid())
  repositoryId         String
  filePath             String?
  maintainabilityIndex Float       // Maintainability Index (0-100)
  cyclomaticComplexity Float
  halsteadVolume       Float
  halsteadDifficulty   Float
  halsteadEffort       Float
  churnVelocity        Float       // lines or commits churned per observation period
  bugFixRatio          Float       @default(0.0)
  loc                  Int         @default(0)
  createdAt            DateTime    @default(now())

  repository           Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@index([repositoryId, createdAt])
  @@index([filePath])
  @@map("maintainability_snapshots")
}


model TerritoryNode {
  id             String   @id @default(uuid())
  nodeKey        String   @unique
  name           String
  region         String
  topicTag       String
  hexQ           Int
  hexR           Int
  ownerGuildId   String?
  ownerGuildName String?
  defensePoints  Int      @default(100)
  conquestPoints Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@index([region])
  @@map("territory_nodes")
}

model GuildClanMessage {
  id        String   @id @default(uuid())
  guildId   String
  senderId  String
  senderName String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([guildId, createdAt])
  @@map("guild_clan_messages")
}

model GuildSeasonRecord {
  id             String   @id @default(uuid())
  seasonNumber   Int
  guildId        String
  guildName      String
  controlledNodes Int
  totalPoints    Int
  trophiesAwarded Int
  treasuryCoins  Int
  resetAt        DateTime @default(now())

  @@index([seasonNumber, totalPoints])
  @@map("guild_season_records")
}

model MatchDisputeAudit {
  id               String   @id @default(uuid())
  disputeId        String   @unique
  matchId          String
  rulingAction     String   // INVALIDATE_MATCH, AWARD_WIN_PLAYER_A, AWARD_WIN_PLAYER_B, SCHEDULE_REMATCH
  judgeId          String
  judgeReason      String   @db.Text
  digitalSignature String
  notifiedPlayers  String
  createdAt        DateTime @default(now())

  @@index([matchId, createdAt])
  @@map("match_dispute_audits")
}
}
